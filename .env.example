# ---- database ----------------------------------------------------------
# One database, on purpose. Rate limits and gate nonces live in Postgres
# too (see backend/app/rate_limits.py and the gate_nonces table).
DATABASE_URL=postgresql://sluice:sluice@localhost:5432/sluice

# ---- bots --------------------------------------------------------------
# Two separate bots from @BotFather. Keeping them separate means a ban on
# delivery does not stop ingest, and vice versa.
UPLOAD_BOT_TOKEN=
UPLOAD_BOT_USERNAME=YourUploadBot
DELIVERY_BOT_TOKEN=
DELIVERY_BOT_USERNAME=YourDeliveryBot

# ---- telegram ----------------------------------------------------------
# Private channel where files live. Keep the -100 prefix.
# Create it from an account that does NOT own the bots, so a bot-account ban
# does not take the channel with it.
STORAGE_CHANNEL_ID=-1001234567890
# Group users must join. @name or numeric ID; the bot must be a member.
REQUIRED_GROUP_ID=@yourgroup
REQUIRED_GROUP_URL=https://t.me/yourgroup

# ---- app ---------------------------------------------------------------
SITE_URL=http://localhost:3000
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

GATE_STEPS=3
GATE_STEP_SECONDS=10
DELIVERY_TOKEN_TTL_SECONDS=600
DELIVERED_MESSAGE_TTL_SECONDS=600

# ---- earnings ------------------------------------------------------------
MIN_PAYOUT_USD=20.00
EARNINGS_HOLD_DAYS=3
EARNINGS_DEDUPE_HOURS=24
BOT_VELOCITY_LIMIT=20
BOT_VELOCITY_WINDOW_SECONDS=3600

# GeoLite2 .mmdb files are NOT in this repo — MaxMind's license terms don't
# allow redistributing them. Create a free account at
# https://www.maxmind.com/en/geolite2/signup, generate a license key, and
# download GeoLite2-Country.mmdb and GeoLite2-ASN.mmdb into backend/geoip/
# (gitignored). Without them, country detection and hosting/VPN bot flagging
# are silently disabled — downloads still work, just unpriced (country_code
# stays null and falls back to the '*' rate in country_rates).
GEOIP_COUNTRY_DB_PATH=./backend/geoip/GeoLite2-Country.mmdb
GEOIP_ASN_DB_PATH=./backend/geoip/GeoLite2-ASN.mmdb

# ---- admin ---------------------------------------------------------------
# Bootstrapped into the `admins` table once, at process startup. Not reset
# by changing these later -- it's a one-time account. Change/reset it by
# editing the `admins` row directly with psql if you ever need to.
ADMIN_USERNAME=
# python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12

# The URL path that reveals the admin login: http://localhost:3000/console/<this>
# NOT read by the backend, and must NEVER be prefixed NEXT_PUBLIC_ -- that
# would bake it into the client JS bundle, readable by anyone via view-source.
# Put the real value in frontend/.env.local (gitignored), not here.
# python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PATH_TOKEN=
